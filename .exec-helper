patterns:
    MODE:
        default-values:
            - debug
            - release
        short-option: m
        long-option: mode
    TARGET:
        default-values:
            - x86_64-unknown-linux-gnu
            #- x86_64-unknown-linux-musl
        long-option: target
    FILTER:
        default-values:
            - ""
        short-option: f
        long-option: filter

commands:
    hello: Command to print hello to the console
    world: Print hello world! to the console
    build: Build the project for the given TARGET
    release: Build release version for the given TARGET
    run: Run the project exdcutable for the given TARGET
    analyze: Analyze the source code
    setup: Setup the repository for building
    docs: Build + install the documentation
    changelog: Build the changelog
    format: Format and check the format of the sources

hello:
#- command-line-command
- bash

world:
- hello
- command-line-command

build:
- command-line-command

release:
- command-line-command

run:
- command-line-command

create-installer:
- command-line-command

format:
- rs-format
- check-changes

analyze:
- clippy
- format

clippy:
- command-line-command

rs-format:
- command-line-command

py-format:
- command-line-command

check-changes:
- command-line-command

docs:
- build-docs
- install-docs

build-docs:
- cmake

install-docs:
- cmake

command-line-command:
    hello:
      command-line: [ echo, "Hello"]

    world:
      patterns:
      - EH_ROOT_DIR
      - TARGET
      environment:
        EH: "exec-helper!"
      working-dir: /tmp
      command-line:
        - pattern: [ echo, "{TARGET}: ${EDITOR}@{EH_ROOT_DIR}"]
        - pwd: [ pwd]

    build:
      patterns:
      - TARGET
      command-line: [ cargo, build, "--target={TARGET}"]

    release:
      patterns:
      - TARGET
      command-line: [ cargo, build, --release, "--target={TARGET}"]

    run:
      patterns:
      - TARGET
      command-line: [ cargo, run, "--target={TARGET}", --, --force-color=true, --log-level=info, --target, blaat, --keep-output, hello, world]

    rs-format:
      command-line: [ cargo, fmt]

    clippy:
      command-line: [ cargo, clippy, --all-targets]

    check-changes:
        command-line: [ git, diff-index, --quiet, HEAD, --]

bash:
    hello:
      command: 'echo "Hello"'
