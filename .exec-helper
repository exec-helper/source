patterns:
    MODE:
        default-values:
            - dev
            #- release
        short-option: m
        long-option: mode
    TARGET:
        default-values:
            - x86_64-unknown-linux-gnu
            #- x86_64-unknown-linux-musl
        long-option: target
    FILTER:
        default-values:
            - ""
        short-option: f
        long-option: filter

commands:
    hello: Command to print hello to the console
    world: Print hello world! to the console
    build: Build the project for the given TARGET
    run: Run the project exdcutable for the given TARGET
    analyze: Analyze the source code
    setup: Setup the repository for building
    docs: Build + install the documentation
    changelog: Build the changelog
    format: Format and check the format of the sources

watch:
- src
- scripts
- Cargo.toml
- .exec-helper

hello:
#- command-line-command
- bash

world:
- hello
- command-line-command

build:
- cargo

run:
- cargo

create-installer:
- command-line-command

format:
- rs-format
- check-changes

analyze:
- clippy
- format

clippy:
- cargo

rs-format:
- cargo

py-format:
- command-line-command

check-changes:
- command-line-command

docs:
- build-docs
- install-docs

build-docs:
- cmake

install-docs:
- cmake

command-line-command:
    world:
      patterns:
      - EH_ROOT_DIR
      - TARGET
      environment:
        EH: "exec-helper!"
      working-dir: /tmp
      command-line:
        - pattern: [ echo, "{TARGET}: ${EDITOR}@{EH_ROOT_DIR}"]
        - pwd: [ pwd]

    check-changes:
        command-line: [ git, diff-index, --quiet, HEAD, --]

bash:
    hello:
      command: 'echo "Hello"'

cargo:
  patterns:
  - TARGET
  - MODE
  target: "{TARGET}"
  profile: "{MODE}"

  build:
    command: build
    command-line: ["--color", "always"]

  run:
    command: run
    program-args: [ --force-color=true, --log-level=warn, --target, blaat, --keep-output, hello, world]

  rs-format:
    patterns: []
    command: fmt

  clippy:
    patterns: []
    command: clippy
    all-targets: yes
